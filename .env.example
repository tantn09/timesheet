DATABASE_URL=postgresql://timesheet:timesheet@localhost:5432/timesheet?schema=public
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
COOKIE_SECURE=false

# Invoice PDF issuer profile (shown on every generated invoice; keep real values in .env only)
INVOICE_ISSUER_NAME=Your Name
INVOICE_ISSUER_EMAIL=you@example.com
INVOICE_ISSUER_PHONE=+44 0000 000000
INVOICE_BANK_ACCOUNT_HOLDER=Your Name
INVOICE_BANK_SORT_CODE=00-00-00
INVOICE_BANK_ACCOUNT_NUMBER=00000000
INVOICE_BANK_IBAN=GB00 TEST 0000 0000 0000 00
